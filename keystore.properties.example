# Copy to keystore.properties (which git ignores, as it does *.jks) and fill in. Used only by the release build.
#
# For Google Play this is the UPLOAD key. Play App Signing (required of new apps) has Google hold the key that signs
# what people install; this one only proves that an upload came from the project, and Play support can replace it if
# it is lost. Make it once, and keep the file and its passwords somewhere safe and backed up all the same:
#
#   keytool -genkeypair -v -keystore paperkites-upload.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
#
# A build handed out directly (not through a store) is signed by this key itself, and there the old rule holds: an
# installed app can only ever be updated by the key that first signed it.
#
# storeFile is relative to the project root.
storeFile=paperkites-upload.jks
storePassword=
keyAlias=upload
keyPassword=
