# Copy to keystore.properties (which git ignores) and fill in. Used only by the release build.
# Make the keystore once, yourself, and keep it and its passwords somewhere safe and backed up:
# an app can only ever be updated by the key that first signed it.
#
#   keytool -genkeypair -v -keystore abcmailbox-release.jks -alias abcmailbox -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is relative to the project root.
storeFile=abcmailbox-release.jks
storePassword=
keyAlias=abcmailbox
keyPassword=
