<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked for the first time a letter is queued offline, so the writer hears what became of it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AbcApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ABCMailbox">

        <!-- WorkManager must not start itself: AbcApplication configures it with Hilt's worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" android:value="androidx.startup" tools:node="remove" />
        </provider>
        <!-- Lets another app (a PDF or image viewer) read a downloaded attachment from our cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ABCMailbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- abcmailbox://claim?token=…: the form that needs no domain behind it, kept beside the https one below. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="abcmailbox" android:host="claim" />
            </intent-filter>
            <!-- The three links the website hands out (it builds each from its own address, paperkites.org since 12 November 2026):
                 /join?code=… on an invite slip's QR code (API PR #116), /claim?token=… at a handoff, /invitation?token=… to a
                 volunteer. autoVerify asks Android to check https://paperkites.org/.well-known/assetlinks.json for this app's
                 identifier and signing certificate. Until the site serves that file, Android 12 and later open these links in the
                 browser (the website handles them), and the app can be made their handler by hand in its "Open by default" settings.
                 The domain attributes of one filter combine, so this is one host with three paths. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="paperkites.org" />
                <data android:path="/join" />
                <data android:path="/claim" />
                <data android:path="/invitation" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="abcmailbox" android:host="join" />
            </intent-filter>
        </activity>
    </application>

</manifest>
